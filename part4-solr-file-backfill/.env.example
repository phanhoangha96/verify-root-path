# Copy thành .env rồi điền giá trị. Không commit file .env.

# --- Solr (bắt buộc) ---
# Chạy trên máy Solr thì để localhost. Core phải đúng môi trường (vd truclt_agency).
SOLR_HOST=http://localhost:8983/solr
SOLR_CORE=eoffice_document
SOLR_USER=
SOLR_PASSWORD=
SOLR_TENANT_CODE=bvhttdl.gov.vn
SOLR_BACKFILL_BATCH_SIZE=20
SOLR_COMMIT_WITHIN_MS=10000
SOLR_TIMEOUT_SECONDS=300

# --- File source: auto | file-service | disk ---
# auto: có FILE_SERVICE_ID thì tải file-service (giống eoffice-solr), không thì đọc disk.
FILE_SOURCE=auto

# File-service (eoffice-solr FileServiceImpl). Bắt buộc nếu FILE_SOURCE=file-service
# hoặc auto với attachment có FILE_SERVICE_ID.
# GET {url}/{fileServiceId}?type=original  Header: TenantCode
FILE_SERVICE_DOWNLOAD_URL=http://localhost:10005/FileService/file/downloadFile
FILE_SERVICE_TIMEOUT_SECONDS=120

# Disk (LEGACY / NFS / chạy trên file server). Dùng khi FILE_SOURCE=disk|auto.
# Nhiều root, phân tách bằng dấu phẩy. Script thử từng root + FILE_PATH.
FILE_STORAGE_ROOTS=/data/u02/data1/voffice/Upload,/data/u03/data1/voffice/Upload,/data/u04/data1/voffice/Upload,/data/u05/data1/voffice/Upload

# Tika: khớp eoffice-solr DocServiceImpl (Apache Tika AutoDetectParser).
# Ưu tiên TIKA_APP_JAR; không có thì dùng package tika (cần Java, lần đầu tải tika-server).
TIKA_APP_JAR=
TIKA_WRITE_LIMIT=100000

# --- Oracle NEW (DB eoffice tenant). Bắt buộc nếu --source NEW hoặc ALL ---
NEW_ORACLE_USER=
NEW_ORACLE_PASSWORD=
NEW_ORACLE_DSN=host:1521/ORCLPDB1
NEW_ORACLE_SCHEMA=
NEW_ORACLE_TENANT_CODE=bvhttdl.gov.vn

# Nhiều tenant NEW: bỏ comment dòng dưới, copy new_oracle_tenants.example.json
# NEW_ORACLE_TENANTS_FILE=./new_oracle_tenants.json

# --- Oracle LEGACY (DB migration). Bắt buộc nếu --source LEGACY hoặc ALL ---
ORACLE_USER=LEGACY
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/ORCLPDB1
ORACLE_SCHEMA=LEGACY

OUTPUT_DIR=./output
OUTPUT_FILE=
