# Copy thành .env rồi điền giá trị. Không commit file .env.

# Oracle LEGACY (schema LEGACY.VB_ATTACHMENT)
ORACLE_USER=LEGACY
ORACLE_PASSWORD=
ORACLE_DSN=10.16.150.233:1521/ORCLPDB1
ORACLE_SCHEMA=LEGACY

# SSH / plocate (file server)
REMOTE_STORAGE_HOST=10.4.202.235
REMOTE_STORAGE_PORT=2222
REMOTE_STORAGE_USERNAME=root
REMOTE_STORAGE_PASSWORD=
REMOTE_STORAGE_PLOCATE_DB=/var/lib/plocate/voffice.db
# Path vật lý trên server (/data/voffice/u0x/...), xem ls /data/voffice
# migration-service dùng path logic /data/u0x/... (STORAGE_SERVICE_DIR_UPLOAD_PATH*);
# storage-service remap: /data/u0x → /data/voffice/u0x (DATA_VOFFICE_HOST_BASE=/data/voffice)
# Nguồn: PATH1/2/4/5/CURRENT trong migration-service/docker-compose.yml
REMOTE_STORAGE_ROOT_FOLDERS=/data/voffice/u02/data1/voffice/Upload,/data/voffice/u03/data1/voffice/Upload,/data/voffice/u04/data1/voffice/Upload,/data/voffice/u05/data1/voffice/Upload,/data/voffice
PLOCATE_LIMIT=32

# CSV cố định; nếu file đã tồn tại → reuse, bỏ dump Oracle
# Ví dụ: MISSING_EXPORT_CSV_PATH=./output/missing-export/aa886dfa05784e35/input.csv
MISSING_EXPORT_CSV_PATH=
# Thư mục job (input.csv / missing.csv)
MISSING_EXPORT_WORK_DIR=./output/missing-export
# Giới hạn số row dump Oracle (0 = all)
MISSING_EXPORT_LIMIT=0
# Số path / 1 SSH exec
MISSING_EXPORT_BATCH_SIZE=100
# Pause sau mỗi N check (ms)
MISSING_EXPORT_THROTTLE_EVERY=500
MISSING_EXPORT_THROTTLE_PAUSE_MS=200
MISSING_EXPORT_PER_CHECK_DELAY_MS=0
# Reconnect SSH sau N check
MISSING_EXPORT_RECONNECT_EVERY=50000
MISSING_EXPORT_RETRY_ATTEMPTS=3
MISSING_EXPORT_RETRY_BACKOFF_MS=500
# Basename fallback plocate -b (giữ false cho job lớn)
MISSING_EXPORT_SEARCH_BY_FILE_NAME=false

OUTPUT_DIR=./output
OUTPUT_FILE=
