# =============================================================================
# Two Oracle databases (different hosts). Both are required for Solr backfill --source ALL.
# =============================================================================

# (1) LEGACY — DB migration (schema LEGACY). Also used by Part 1/2 attachment tools.
# Alias: LEGACY_ORACLE_* falls back to ORACLE_* if unset.
ORACLE_USER=LEGACY
ORACLE_PASSWORD=
ORACLE_DSN=10.16.150.233:1521/ORCLPDB1
ORACLE_SCHEMA=LEGACY
# LEGACY_ORACLE_USER=
# LEGACY_ORACLE_PASSWORD=
# LEGACY_ORACLE_DSN=
# LEGACY_ORACLE_SCHEMA=

# (2) NEW — DB eoffice tenant (khác host với LEGACY). Solr backfill reads VB_INCOMING_DOC / VB_OUTGOING_DOC here.
NEW_ORACLE_USER=
NEW_ORACLE_PASSWORD=
NEW_ORACLE_DSN=
NEW_ORACLE_SCHEMA=
NEW_ORACLE_TENANT_CODE=bvhttdl.gov.vn
# Optional JSON array of extra NEW tenants (user, password, dsn, schema, tenant_code)
NEW_ORACLE_TENANTS_FILE=

# SSH / plocate (same as storage-service)
REMOTE_STORAGE_HOST=10.4.202.235
REMOTE_STORAGE_PORT=2222
REMOTE_STORAGE_USERNAME=root
REMOTE_STORAGE_PASSWORD=
REMOTE_STORAGE_PLOCATE_DB=/var/lib/plocate/voffice.db
REMOTE_STORAGE_ROOT_FOLDERS=/data/u02/data1/voffice/Upload,/data/u02/data2/voffice/Upload,/data/u03/data1/voffice/Upload,/data/u03/data1/voffice/Upload/Upload,/data/u04/data1/voffice/Upload,/data/u05/data1/voffice/Upload

# ---------------------------------------------------------------------------
# Part 1 — root-path audit (python verify_root_path.py)
# ---------------------------------------------------------------------------
# Number of attachments sampled per ROOT_PATH value (including NULL). 0 = all rows.
SAMPLE_PER_ROOT_PATH=200
# Max rows overall (0 = unlimited). Applied after sample-per-group.
SAMPLE_LIMIT=0
# Batch size for remote plocate stdin loop (Part 1)
PLOCATE_BATCH_SIZE=50
PLOCATE_LIMIT=32
# Only rows with FILE_PATH not null; optionally require IS_HAS_FILE=1
REQUIRE_HAS_FILE=true
# Exclude soft-deleted rows when IS_DELETE column exists
EXCLUDE_DELETED=true

# ---------------------------------------------------------------------------
# Part 2 — export missing files (python export_missing.py)
# Port of migration-service exportMissingFiles + storage-service missing/jobs
# ---------------------------------------------------------------------------
# Optional fixed input CSV (path,fileName). If file exists → reuse (skip Oracle dump).
MISSING_EXPORT_CSV_PATH=
# Work dir for job folders (input.csv / missing.csv)
MISSING_EXPORT_WORK_DIR=./output/missing-export
# Cap Oracle dump for dry-run (0 = all rows)
MISSING_EXPORT_LIMIT=0
# Paths per SSH exec
MISSING_EXPORT_BATCH_SIZE=100
# Pause after every N checks (ms)
MISSING_EXPORT_THROTTLE_EVERY=500
MISSING_EXPORT_THROTTLE_PAUSE_MS=200
MISSING_EXPORT_PER_CHECK_DELAY_MS=0
# Reconnect SSH after N checks
MISSING_EXPORT_RECONNECT_EVERY=50000
MISSING_EXPORT_RETRY_ATTEMPTS=3
MISSING_EXPORT_RETRY_BACKOFF_MS=500
# Basename fallback plocate -b (keep false for large jobs)
MISSING_EXPORT_SEARCH_BY_FILE_NAME=false

# Output (both parts + Solr backfill)
OUTPUT_DIR=./output
OUTPUT_FILE=

# ---------------------------------------------------------------------------
# Part 3 — Solr metadata backfill (python solr_doc_meta_backfill.py)
# Index searchText for existing NEW + LEGACY documents. No eoffice API.
# ---------------------------------------------------------------------------
SOLR_HOST=http://localhost:8983/solr
SOLR_CORE=eoffice_document
SOLR_USER=
SOLR_PASSWORD=
SOLR_TENANT_CODE=bvhttdl.gov.vn
SOLR_BACKFILL_BATCH_SIZE=200
SOLR_COMMIT_WITHIN_MS=10000
