# Oracle (LEGACY.VB_ATTACHMENT)
ORACLE_USER=LEGACY
ORACLE_PASSWORD=
ORACLE_DSN=10.16.150.233:1521/ORCLPDB1
ORACLE_SCHEMA=LEGACY

# SSH / plocate (same as storage-service)
REMOTE_STORAGE_HOST=10.4.202.235
REMOTE_STORAGE_PORT=2222
REMOTE_STORAGE_USERNAME=root
REMOTE_STORAGE_PASSWORD=
REMOTE_STORAGE_PLOCATE_DB=/var/lib/plocate/voffice.db
REMOTE_STORAGE_ROOT_FOLDERS=/data/u02/data1/voffice/Upload,/data/u02/data2/voffice/Upload,/data/u03/data1/voffice/Upload,/data/u03/data1/voffice/Upload/Upload,/data/u04/data1/voffice/Upload,/data/u05/data1/voffice/Upload

# Sampling / performance
# Number of attachments sampled per ROOT_PATH value (including NULL). 0 = all rows.
SAMPLE_PER_ROOT_PATH=200
# Max rows overall (0 = unlimited). Applied after sample-per-group.
SAMPLE_LIMIT=0
# Batch size for remote plocate stdin loop
PLOCATE_BATCH_SIZE=50
PLOCATE_LIMIT=32
# Only rows with FILE_PATH not null; optionally require IS_HAS_FILE=1
REQUIRE_HAS_FILE=true
# Exclude soft-deleted rows when IS_DELETE column exists
EXCLUDE_DELETED=true

# Output
OUTPUT_DIR=./output
OUTPUT_FILE=
